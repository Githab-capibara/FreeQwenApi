# Container images of the security scanners, pinned by digest.
#
# This file is the single source of truth for the scanner images. The CI jobs
# and the baseline generator (scripts/ci/update-baselines.sh) read it, so a
# scan always runs against exactly the image that the recorded baseline
# describes.
#
# Why a digest and not a tag: a moving tag (`:latest`) lets the finding set
# change underneath the baseline. The baseline mechanism cannot tell such a
# drift apart from a real regression, so a silently replaced scanner image
# would either hide a finding or block the build for the wrong reason.
#
# How to update a pin:
#   1. Pick the tag:  docker buildx imagetools inspect <image>:<tag>
#   2. Resolve it:    docker buildx imagetools inspect <image>:<tag> \
#                       --format '{{.Manifest.Digest}}'
#   3. Replace the digest below and note the new tag in the comment.
#   4. Regenerate the affected baseline and review the diff:
#      scripts/ci/update-baselines.sh
#
# The format is `NAME=value` so that the file can be sourced from Bash.

# Bearer — data-flow analysis for the JavaScript sources.
BEARER_IMAGE=ghcr.io/bearer/bearer@sha256:96bf92f6baa76c12148fa1a20f99b7e320017d5e7be794fbfe72843c7b0d2d65 # v2.1.3

# OSV-Scanner — dependency vulnerabilities from the Open Source Vulnerabilities database.
OSV_SCANNER_IMAGE=ghcr.io/google/osv-scanner@sha256:4f3b7e2c64b9d38a5febc5a7e4a3dfef1d1362f726dea7a2ef4762b46469fcd0 # latest

# Zizmor — GitHub Actions security analysis.
ZIZMOR_IMAGE=ghcr.io/zizmorcore/zizmor@sha256:3014cc8f68f663935f69b3c3e0e41f5ce102b268d97db13db0f62208747f860d # latest

# Dockle — Docker best practices.
DOCKLE_IMAGE=goodwithtech/dockle@sha256:eade932f793742de0aa8755406c7677cd7696f8675b6180926f7eeffa7abe6b9 # latest

