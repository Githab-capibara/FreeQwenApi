TRUFFLEHOG_IMAGE=trufflesecurity/trufflehog@sha256:674b2f187620a19df77f44cf9a7d77efcc581a5662accef2f2739cbb46ba4a3a # latest

# Trivy — vulnerability and secret scan.
TRIVY_IMAGE=aquasec/trivy@sha256:1c78ed1ef824ab8bb05b04359d186e4c1229d0b3e67005faacb54a7d71974f73 # v0.69.1

